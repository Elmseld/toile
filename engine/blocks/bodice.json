{
  "version": 1,
  "name": "Bodice",
  "source": "Based on Winifred Aldrich, Metric Pattern Cutting for Women's Wear, 6th ed. (Wiley-Blackwell, 2015), \"The close fitting bodice block\". Deviations: back and front are drafted in separate frames 50 mm apart; instead of the book's size-chart dart, the front neck point and the bust dart follow from the front_length, bust_height and bust_distance measurements (the front neck point is placed so that neck point, bust point and waist add up to front_length, and the bust dart is the rotation about the bust point that brings the front shoulder point level with the back shoulder point, capped at max_bust_dart_angle); the bust dart stays in the shoulder and the waist suppression is split equally between the waist dart and the side seam; the ease and the draft constants (side_shift, back_neck_rise, front_neck_extra, back_shoulder_drop, front_shoulder_drop, back_shoulder_dart, back_shoulder_dart_length, back_waist_dart_gap, front_waist_dart_gap, ease_back_width, max_bust_dart_angle) are parameters whose defaults are not yet checked against the book.",
  "measurements": ["bust", "waist", "neck", "shoulder_width", "back_width", "chest_width", "back_length", "armhole_depth", "front_length", "bust_height", "bust_distance"],
  "parameters": {
    "ease_bust": 80,
    "ease_waist": 40,
    "ease_armhole_depth": 10,
    "ease_back_width": 10,
    "side_shift": 10,
    "back_neck_rise": 20,
    "front_neck_extra": 10,
    "back_shoulder_drop": 40,
    "front_shoulder_drop": 40,
    "back_shoulder_dart": 10,
    "back_shoulder_dart_length": 80,
    "back_waist_dart_gap": 20,
    "front_waist_dart_gap": 20,
    "max_bust_dart_angle": 15
  },
  "formulas": {
    "underarm_y": "armhole_depth + ease_armhole_depth",
    "width_y": "underarm_y / 2",
    "bust_quarter": "(bust + ease_bust) / 4",
    "waist_quarter": "(waist + ease_waist) / 4",
    "back_bust": "bust_quarter - side_shift",
    "front_bust": "bust_quarter + side_shift",
    "back_waist": "waist_quarter - side_shift",
    "front_waist": "waist_quarter + side_shift",
    "suppression": "bust_quarter - waist_quarter",
    "waist_dart": "max(0, suppression / 2)",
    "neck_width": "neck / 5 - 2",
    "front_neck_depth": "neck / 5 + front_neck_extra",
    "back_width_half": "(back_width + ease_back_width) / 2",
    "chest_half": "chest_width / 2",
    "back_shoulder_length": "shoulder_width + back_shoulder_dart",
    "bp_y": "back_length - front_length + bust_height",
    "shoulder_y": "back_shoulder_drop - back_neck_rise",
    "bust_dart_balance_angle": "max(0, angle(f_bp, f_shoulder_closed) - 180 - asin(max(-1, min(1, (bp_y - shoulder_y) / distance(f_bp, f_shoulder_closed)))))",
    "bust_dart_angle": "min(max_bust_dart_angle, bust_dart_balance_angle)",
    "bust_dart_neck_angle": "angle(f_bp, f_bdart_neck)",
    "bust_dart_at_underarm": "max(0, bp_y - underarm_y) * (cos(bust_dart_neck_angle - bust_dart_angle) / sin(bust_dart_neck_angle - bust_dart_angle) - cos(bust_dart_neck_angle) / sin(bust_dart_neck_angle))",
    "front_waist_dart": "waist_dart + bust_dart_at_underarm",
    "piece_gap": "50",
    "back_armhole_length": "length(b_armhole_upper) + length(b_armhole_lower)",
    "front_armhole_length": "length(f_armhole_lower) + length(f_armhole_upper)",
    "armhole_length": "back_armhole_length + front_armhole_length"
  },
  "points": [
    { "name": "b_nape", "op": "start", "x": "0", "y": "0" },
    { "name": "b_neck", "op": "offset", "from": "b_nape", "dx": "neck_width", "dy": "-back_neck_rise" },
    { "name": "b_neck_c1", "op": "offset", "from": "b_nape", "dx": "neck_width / 2", "dy": "0" },
    { "name": "b_neck_c2", "op": "offset", "from": "b_neck", "dx": "0", "dy": "back_neck_rise / 2" },
    { "name": "b_underarm_cb", "op": "offset", "from": "b_nape", "dx": "0", "dy": "underarm_y" },
    { "name": "b_waist_cb", "op": "offset", "from": "b_nape", "dx": "0", "dy": "back_length" },
    { "name": "b_side_top", "op": "offset", "from": "b_underarm_cb", "dx": "back_bust", "dy": "0" },
    { "name": "b_width_pt", "op": "offset", "from": "b_nape", "dx": "back_width_half", "dy": "width_y" },
    { "name": "b_arm_corner", "op": "offset", "from": "b_underarm_cb", "dx": "back_width_half", "dy": "0" },
    { "name": "b_shoulder_level", "op": "offset", "from": "b_neck", "dx": "0", "dy": "back_shoulder_drop" },
    { "name": "b_shoulder_level_r", "op": "offset", "from": "b_shoulder_level", "dx": "100", "dy": "0" },
    { "name": "b_shoulder", "op": "line_circle_intersection", "line": ["b_shoulder_level", "b_shoulder_level_r"], "center": "b_neck", "radius": "back_shoulder_length", "which": "second" },
    { "name": "b_sdart_neck", "op": "along_line", "from": "b_neck", "to": "b_shoulder", "distance": "shoulder_width / 2" },
    { "name": "b_sdart_mid", "op": "along_line", "from": "b_neck", "to": "b_shoulder", "distance": "shoulder_width / 2 + back_shoulder_dart / 2" },
    { "name": "b_sdart_arm", "op": "along_line", "from": "b_neck", "to": "b_shoulder", "distance": "shoulder_width / 2 + back_shoulder_dart" },
    { "name": "b_sdart_apex", "op": "perpendicular", "from": "b_sdart_mid", "to": "b_shoulder", "distance": "back_shoulder_dart_length" },
    { "name": "b_arm_c1", "op": "perpendicular", "from": "b_shoulder", "to": "b_sdart_arm", "distance": "-distance(b_shoulder, b_width_pt) / 3" },
    { "name": "b_arm_c2", "op": "offset", "from": "b_width_pt", "dx": "0", "dy": "-distance(b_shoulder, b_width_pt) / 3" },
    { "name": "b_arm_c3", "op": "along_line", "from": "b_width_pt", "to": "b_arm_corner", "distance": "distance(b_width_pt, b_arm_corner) * 0.55" },
    { "name": "b_arm_c4", "op": "along_line", "from": "b_side_top", "to": "b_arm_corner", "distance": "distance(b_side_top, b_arm_corner) * 0.55" },
    { "name": "b_waist_side", "op": "offset", "from": "b_waist_cb", "dx": "back_waist + waist_dart", "dy": "0" },
    { "name": "b_wdart_mid", "op": "offset", "from": "b_waist_cb", "dx": "back_waist / 2", "dy": "0" },
    { "name": "b_wdart_cb", "op": "offset", "from": "b_wdart_mid", "dx": "-waist_dart / 2", "dy": "0" },
    { "name": "b_wdart_side", "op": "offset", "from": "b_wdart_mid", "dx": "waist_dart / 2", "dy": "0" },
    { "name": "b_wdart_apex", "op": "offset", "from": "b_underarm_cb", "dx": "back_waist / 2", "dy": "back_waist_dart_gap" },
    { "name": "b_grain_top", "op": "offset", "from": "b_nape", "dx": "back_waist / 4", "dy": "width_y" },
    { "name": "b_grain_bottom", "op": "offset", "from": "b_waist_cb", "dx": "back_waist / 4", "dy": "-50" },

    { "name": "f_waist_cf", "op": "offset", "from": "b_waist_cb", "dx": "back_bust + piece_gap + front_bust", "dy": "0" },
    { "name": "f_underarm_cf", "op": "offset", "from": "b_underarm_cb", "dx": "back_bust + piece_gap + front_bust", "dy": "0" },
    { "name": "f_bp", "op": "offset", "from": "f_waist_cf", "dx": "-bust_distance / 2", "dy": "-(front_length - bust_height)" },
    { "name": "f_neck_foot", "op": "offset", "from": "f_waist_cf", "dx": "-neck_width", "dy": "0" },
    { "name": "f_neck_up", "op": "offset", "from": "f_neck_foot", "dx": "0", "dy": "-100" },
    { "name": "f_neck", "op": "line_circle_intersection", "line": ["f_neck_foot", "f_neck_up"], "center": "f_bp", "radius": "bust_height", "which": "second" },
    { "name": "f_neck_cf", "op": "offset", "from": "f_neck", "dx": "neck_width", "dy": "front_neck_depth" },
    { "name": "f_neck_corner", "op": "offset", "from": "f_neck", "dx": "0", "dy": "front_neck_depth" },
    { "name": "f_neck_c1", "op": "along_line", "from": "f_neck", "to": "f_neck_corner", "distance": "front_neck_depth * 0.55" },
    { "name": "f_neck_c2", "op": "along_line", "from": "f_neck_cf", "to": "f_neck_corner", "distance": "neck_width * 0.55" },
    { "name": "f_shoulder_level", "op": "offset", "from": "f_neck", "dx": "0", "dy": "front_shoulder_drop" },
    { "name": "f_shoulder_level_r", "op": "offset", "from": "f_shoulder_level", "dx": "100", "dy": "0" },
    { "name": "f_shoulder_closed", "op": "line_circle_intersection", "line": ["f_shoulder_level", "f_shoulder_level_r"], "center": "f_neck", "radius": "shoulder_width", "which": "first" },
    { "name": "f_bdart_neck", "op": "along_line", "from": "f_neck", "to": "f_shoulder_closed", "distance": "shoulder_width / 2" },
    { "name": "f_bdart_arm", "op": "along_angle", "from": "f_bp", "angle": "bust_dart_neck_angle - bust_dart_angle", "distance": "distance(f_bp, f_bdart_neck)" },
    { "name": "f_shoulder", "op": "along_angle", "from": "f_bp", "angle": "angle(f_bp, f_shoulder_closed) - bust_dart_angle", "distance": "distance(f_bp, f_shoulder_closed)" },
    { "name": "f_side_top", "op": "offset", "from": "f_underarm_cf", "dx": "-(front_bust + bust_dart_at_underarm)", "dy": "0" },
    { "name": "f_chest_mid", "op": "midpoint", "from": "f_shoulder_closed", "to": "f_underarm_cf" },
    { "name": "f_chest_mid_r", "op": "offset", "from": "f_chest_mid", "dx": "100", "dy": "0" },
    { "name": "f_chest_foot", "op": "offset", "from": "f_underarm_cf", "dx": "-chest_half", "dy": "0" },
    { "name": "f_chest_up", "op": "offset", "from": "f_chest_foot", "dx": "0", "dy": "-100" },
    { "name": "f_chest_closed", "op": "line_intersection", "line1": ["f_chest_foot", "f_chest_up"], "line2": ["f_chest_mid", "f_chest_mid_r"] },
    { "name": "f_chest", "op": "along_angle", "from": "f_bp", "angle": "angle(f_bp, f_chest_closed) - bust_dart_angle", "distance": "distance(f_bp, f_chest_closed)" },
    { "name": "f_chest_down", "op": "offset", "from": "f_chest", "dx": "0", "dy": "100" },
    { "name": "f_arm_corner", "op": "line_intersection", "line1": ["f_chest", "f_chest_down"], "line2": ["f_side_top", "f_underarm_cf"] },
    { "name": "f_arm_c1", "op": "along_line", "from": "f_side_top", "to": "f_arm_corner", "distance": "distance(f_side_top, f_arm_corner) * 0.55" },
    { "name": "f_arm_c2", "op": "along_line", "from": "f_chest", "to": "f_arm_corner", "distance": "distance(f_chest, f_arm_corner) * 0.55" },
    { "name": "f_arm_c3", "op": "offset", "from": "f_chest", "dx": "0", "dy": "-distance(f_chest, f_shoulder) / 3" },
    { "name": "f_arm_c4", "op": "perpendicular", "from": "f_shoulder", "to": "f_bdart_arm", "distance": "distance(f_chest, f_shoulder) / 3" },
    { "name": "f_waist_side", "op": "offset", "from": "f_waist_cf", "dx": "-(front_waist + front_waist_dart)", "dy": "0" },
    { "name": "f_wdart_mid", "op": "offset", "from": "f_waist_cf", "dx": "-bust_distance / 2", "dy": "0" },
    { "name": "f_wdart_side", "op": "offset", "from": "f_wdart_mid", "dx": "-front_waist_dart / 2", "dy": "0" },
    { "name": "f_wdart_cf", "op": "offset", "from": "f_wdart_mid", "dx": "front_waist_dart / 2", "dy": "0" },
    { "name": "f_wdart_apex", "op": "offset", "from": "f_bp", "dx": "0", "dy": "max(front_waist_dart_gap, underarm_y - bp_y)" },
    { "name": "f_grain_top", "op": "offset", "from": "f_neck_cf", "dx": "-bust_distance / 4", "dy": "50" },
    { "name": "f_grain_bottom", "op": "offset", "from": "f_waist_cf", "dx": "-bust_distance / 4", "dy": "-50" }
  ],
  "curves": [
    { "name": "b_neckline", "type": "cubic", "from": "b_nape", "c1": "b_neck_c1", "c2": "b_neck_c2", "to": "b_neck" },
    { "name": "b_shoulder_neck", "type": "line", "from": "b_neck", "to": "b_sdart_neck" },
    { "name": "b_sdart_leg_neck", "type": "line", "from": "b_sdart_neck", "to": "b_sdart_apex" },
    { "name": "b_sdart_leg_arm", "type": "line", "from": "b_sdart_apex", "to": "b_sdart_arm" },
    { "name": "b_shoulder_arm", "type": "line", "from": "b_sdart_arm", "to": "b_shoulder" },
    { "name": "b_armhole_upper", "type": "cubic", "from": "b_shoulder", "c1": "b_arm_c1", "c2": "b_arm_c2", "to": "b_width_pt" },
    { "name": "b_armhole_lower", "type": "cubic", "from": "b_width_pt", "c1": "b_arm_c3", "c2": "b_arm_c4", "to": "b_side_top" },
    { "name": "b_side", "type": "line", "from": "b_side_top", "to": "b_waist_side" },
    { "name": "b_waist_side_seg", "type": "line", "from": "b_waist_side", "to": "b_wdart_side" },
    { "name": "b_wdart_leg_side", "type": "line", "from": "b_wdart_side", "to": "b_wdart_apex" },
    { "name": "b_wdart_leg_cb", "type": "line", "from": "b_wdart_apex", "to": "b_wdart_cb" },
    { "name": "b_waist_cb_seg", "type": "line", "from": "b_wdart_cb", "to": "b_waist_cb" },
    { "name": "b_cb", "type": "line", "from": "b_waist_cb", "to": "b_nape" },

    { "name": "f_neckline", "type": "cubic", "from": "f_neck", "c1": "f_neck_c1", "c2": "f_neck_c2", "to": "f_neck_cf" },
    { "name": "f_cf", "type": "line", "from": "f_neck_cf", "to": "f_waist_cf" },
    { "name": "f_waist_cf_seg", "type": "line", "from": "f_waist_cf", "to": "f_wdart_cf" },
    { "name": "f_wdart_leg_cf", "type": "line", "from": "f_wdart_cf", "to": "f_wdart_apex" },
    { "name": "f_wdart_leg_side", "type": "line", "from": "f_wdart_apex", "to": "f_wdart_side" },
    { "name": "f_waist_side_seg", "type": "line", "from": "f_wdart_side", "to": "f_waist_side" },
    { "name": "f_side", "type": "line", "from": "f_waist_side", "to": "f_side_top" },
    { "name": "f_armhole_lower", "type": "cubic", "from": "f_side_top", "c1": "f_arm_c1", "c2": "f_arm_c2", "to": "f_chest" },
    { "name": "f_armhole_upper", "type": "cubic", "from": "f_chest", "c1": "f_arm_c3", "c2": "f_arm_c4", "to": "f_shoulder" },
    { "name": "f_shoulder_arm", "type": "line", "from": "f_shoulder", "to": "f_bdart_arm" },
    { "name": "f_bdart_leg_arm", "type": "line", "from": "f_bdart_arm", "to": "f_bp" },
    { "name": "f_bdart_leg_neck", "type": "line", "from": "f_bp", "to": "f_bdart_neck" },
    { "name": "f_shoulder_neck", "type": "line", "from": "f_bdart_neck", "to": "f_neck" }
  ],
  "pieces": [
    {
      "name": "back",
      "outline": [
        { "curve": "b_neckline" },
        { "curve": "b_shoulder_neck" },
        { "curve": "b_sdart_leg_neck" },
        { "curve": "b_sdart_leg_arm" },
        { "curve": "b_shoulder_arm" },
        { "curve": "b_armhole_upper" },
        { "curve": "b_armhole_lower" },
        { "curve": "b_side" },
        { "curve": "b_waist_side_seg" },
        { "curve": "b_wdart_leg_side" },
        { "curve": "b_wdart_leg_cb" },
        { "curve": "b_waist_cb_seg" },
        { "curve": "b_cb" }
      ],
      "grainline": { "from": "b_grain_top", "to": "b_grain_bottom" }
    },
    {
      "name": "front",
      "outline": [
        { "curve": "f_neckline" },
        { "curve": "f_cf" },
        { "curve": "f_waist_cf_seg" },
        { "curve": "f_wdart_leg_cf" },
        { "curve": "f_wdart_leg_side" },
        { "curve": "f_waist_side_seg" },
        { "curve": "f_side" },
        { "curve": "f_armhole_lower" },
        { "curve": "f_armhole_upper" },
        { "curve": "f_shoulder_arm" },
        { "curve": "f_bdart_leg_arm" },
        { "curve": "f_bdart_leg_neck" },
        { "curve": "f_shoulder_neck" }
      ],
      "grainline": { "from": "f_grain_top", "to": "f_grain_bottom" }
    }
  ]
}
