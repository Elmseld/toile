{
  "version": 1,
  "name": "Straight sleeve",
  "source": "Based on Winifred Aldrich, Metric Pattern Cutting for Women's Wear, 6th ed. (Wiley-Blackwell, 2015), the one-piece sleeve block. Deviations: the sleeve cap is constructed rather than drawn: each half runs diagonally from the crown to its underarm point as a convex circular arc, a straight piece sloping cap_inflection_tilt steeper than the guide line from the crown to the underarm point, and a concave circular arc of the same turn, so the crown rises above the guide line and the lower part hollows below it (two arcs alone where the tilt reaches the guide angle); the cap height is not measured but solved (a few Newton steps written as formulas) so that the cap equals the armhole imported from the bodice plus cap_ease, and the crown is shifted so that each half matches its own armhole half (back and front armholes differ); all cap ease lies between the notches, which sit at the same arc distance from the underarm points as the bodice notches from the side points, with a crown notch matching the shoulder seam; the underarm seams taper straight to a hem of wrist plus ease_wrist, centred under the bicep line; the ease and the constants (ease_upper_arm, ease_wrist, cap_ease, cap_convex_share, cap_inflection_tilt) are our own starting values, set and pinned by the engine tests, to be adjusted after test fitting (a toile/provsömnad).",
  "measurements": ["upper_arm", "arm_length", "wrist"],
  "imports": {
    "back_armhole_length": "bodice.back_armhole_length",
    "front_armhole_length": "bodice.front_armhole_length",
    "back_armhole_to_notch": "bodice.back_armhole_to_notch",
    "front_armhole_to_notch": "bodice.front_armhole_to_notch"
  },
  "parameters": {
    "ease_upper_arm": 50,
    "ease_wrist": 80,
    "length_adjustment": 0,
    "cap_ease": 30,
    "cap_convex_share": 0.6,
    "cap_inflection_tilt": 15
  },
  "formulas": {
    "bicep": "upper_arm + ease_upper_arm",
    "hem_width": "wrist + ease_wrist",
    "sleeve_length": "arm_length + length_adjustment",
    "back_cap_target": "back_armhole_length + cap_ease / 2",
    "front_cap_target": "front_armhole_length + cap_ease / 2",
    "cap_split_0": "(front_cap_target * front_cap_target - back_cap_target * back_cap_target) / (2 * bicep)",
    "cap_h_0": "sqrt(front_cap_target * front_cap_target - (bicep / 2 + cap_split_0) * (bicep / 2 + cap_split_0))",
    "cap_wf_1": "bicep / 2 + cap_split_0",
    "cap_wb_1": "bicep / 2 - cap_split_0",
    "cap_af_1": "atan2(cap_h_0, cap_wf_1)",
    "cap_tf_1": "min(cap_af_1 + min(cap_af_1, cap_inflection_tilt), 90)",
    "cap_sf_1": "cap_h_0 / tan(cap_tf_1 / 2) - cap_wf_1",
    "cap_rf_1": "(cap_wf_1 * sin(cap_tf_1) - cap_h_0 * cos(cap_tf_1)) / (1 - cos(cap_tf_1))",
    "cap_lf_1": "cap_rf_1 * rad(cap_tf_1) + cap_sf_1",
    "cap_dlfh_1": "1 / tan(cap_tf_1 / 2) - rad(cap_tf_1) * cos(cap_tf_1) / (1 - cos(cap_tf_1)) + (cap_sf_1 * rad(cap_tf_1) + cap_wf_1 * sin(cap_tf_1) - cap_h_0 * (1 + cos(cap_tf_1))) / (1 - cos(cap_tf_1)) * cap_wf_1 / (cap_wf_1 * cap_wf_1 + cap_h_0 * cap_h_0) * (90 - cap_tf_1) / max(90 - cap_tf_1, 0.000001)",
    "cap_ab_1": "atan2(cap_h_0, cap_wb_1)",
    "cap_tb_1": "min(cap_ab_1 + min(cap_ab_1, cap_inflection_tilt), 90)",
    "cap_sb_1": "cap_h_0 / tan(cap_tb_1 / 2) - cap_wb_1",
    "cap_rb_1": "(cap_wb_1 * sin(cap_tb_1) - cap_h_0 * cos(cap_tb_1)) / (1 - cos(cap_tb_1))",
    "cap_lb_1": "cap_rb_1 * rad(cap_tb_1) + cap_sb_1",
    "cap_dlbh_1": "1 / tan(cap_tb_1 / 2) - rad(cap_tb_1) * cos(cap_tb_1) / (1 - cos(cap_tb_1)) + (cap_sb_1 * rad(cap_tb_1) + cap_wb_1 * sin(cap_tb_1) - cap_h_0 * (1 + cos(cap_tb_1))) / (1 - cos(cap_tb_1)) * cap_wb_1 / (cap_wb_1 * cap_wb_1 + cap_h_0 * cap_h_0) * (90 - cap_tb_1) / max(90 - cap_tb_1, 0.000001)",
    "cap_h_1": "cap_h_0 - (cap_lf_1 + cap_lb_1 - front_cap_target - back_cap_target) / (cap_dlfh_1 + cap_dlbh_1)",
    "cap_wf_2": "bicep / 2 + cap_split_0",
    "cap_wb_2": "bicep / 2 - cap_split_0",
    "cap_af_2": "atan2(cap_h_1, cap_wf_2)",
    "cap_tf_2": "min(cap_af_2 + min(cap_af_2, cap_inflection_tilt), 90)",
    "cap_sf_2": "cap_h_1 / tan(cap_tf_2 / 2) - cap_wf_2",
    "cap_rf_2": "(cap_wf_2 * sin(cap_tf_2) - cap_h_1 * cos(cap_tf_2)) / (1 - cos(cap_tf_2))",
    "cap_lf_2": "cap_rf_2 * rad(cap_tf_2) + cap_sf_2",
    "cap_dlfh_2": "1 / tan(cap_tf_2 / 2) - rad(cap_tf_2) * cos(cap_tf_2) / (1 - cos(cap_tf_2)) + (cap_sf_2 * rad(cap_tf_2) + cap_wf_2 * sin(cap_tf_2) - cap_h_1 * (1 + cos(cap_tf_2))) / (1 - cos(cap_tf_2)) * cap_wf_2 / (cap_wf_2 * cap_wf_2 + cap_h_1 * cap_h_1) * (90 - cap_tf_2) / max(90 - cap_tf_2, 0.000001)",
    "cap_ab_2": "atan2(cap_h_1, cap_wb_2)",
    "cap_tb_2": "min(cap_ab_2 + min(cap_ab_2, cap_inflection_tilt), 90)",
    "cap_sb_2": "cap_h_1 / tan(cap_tb_2 / 2) - cap_wb_2",
    "cap_rb_2": "(cap_wb_2 * sin(cap_tb_2) - cap_h_1 * cos(cap_tb_2)) / (1 - cos(cap_tb_2))",
    "cap_lb_2": "cap_rb_2 * rad(cap_tb_2) + cap_sb_2",
    "cap_dlbh_2": "1 / tan(cap_tb_2 / 2) - rad(cap_tb_2) * cos(cap_tb_2) / (1 - cos(cap_tb_2)) + (cap_sb_2 * rad(cap_tb_2) + cap_wb_2 * sin(cap_tb_2) - cap_h_1 * (1 + cos(cap_tb_2))) / (1 - cos(cap_tb_2)) * cap_wb_2 / (cap_wb_2 * cap_wb_2 + cap_h_1 * cap_h_1) * (90 - cap_tb_2) / max(90 - cap_tb_2, 0.000001)",
    "cap_h_2": "cap_h_1 - (cap_lf_2 + cap_lb_2 - front_cap_target - back_cap_target) / (cap_dlfh_2 + cap_dlbh_2)",
    "cap_wf_s": "bicep / 2 + cap_split_0",
    "cap_wb_s": "bicep / 2 - cap_split_0",
    "cap_af_s": "atan2(cap_h_2, cap_wf_s)",
    "cap_tf_s": "min(cap_af_s + min(cap_af_s, cap_inflection_tilt), 90)",
    "cap_sf_s": "cap_h_2 / tan(cap_tf_s / 2) - cap_wf_s",
    "cap_rf_s": "(cap_wf_s * sin(cap_tf_s) - cap_h_2 * cos(cap_tf_s)) / (1 - cos(cap_tf_s))",
    "cap_lf_s": "cap_rf_s * rad(cap_tf_s) + cap_sf_s",
    "cap_dlfh_s": "1 / tan(cap_tf_s / 2) - rad(cap_tf_s) * cos(cap_tf_s) / (1 - cos(cap_tf_s)) + (cap_sf_s * rad(cap_tf_s) + cap_wf_s * sin(cap_tf_s) - cap_h_2 * (1 + cos(cap_tf_s))) / (1 - cos(cap_tf_s)) * cap_wf_s / (cap_wf_s * cap_wf_s + cap_h_2 * cap_h_2) * (90 - cap_tf_s) / max(90 - cap_tf_s, 0.000001)",
    "cap_dlfw_s": "(cap_lf_s - cap_h_2 * cap_dlfh_s) / cap_wf_s",
    "cap_ab_s": "atan2(cap_h_2, cap_wb_s)",
    "cap_tb_s": "min(cap_ab_s + min(cap_ab_s, cap_inflection_tilt), 90)",
    "cap_sb_s": "cap_h_2 / tan(cap_tb_s / 2) - cap_wb_s",
    "cap_rb_s": "(cap_wb_s * sin(cap_tb_s) - cap_h_2 * cos(cap_tb_s)) / (1 - cos(cap_tb_s))",
    "cap_lb_s": "cap_rb_s * rad(cap_tb_s) + cap_sb_s",
    "cap_dlbh_s": "1 / tan(cap_tb_s / 2) - rad(cap_tb_s) * cos(cap_tb_s) / (1 - cos(cap_tb_s)) + (cap_sb_s * rad(cap_tb_s) + cap_wb_s * sin(cap_tb_s) - cap_h_2 * (1 + cos(cap_tb_s))) / (1 - cos(cap_tb_s)) * cap_wb_s / (cap_wb_s * cap_wb_s + cap_h_2 * cap_h_2) * (90 - cap_tb_s) / max(90 - cap_tb_s, 0.000001)",
    "cap_dlbw_s": "(cap_lb_s - cap_h_2 * cap_dlbh_s) / cap_wb_s",
    "cap_split_1": "cap_split_0 - ((cap_lf_s - front_cap_target) - (cap_lb_s - back_cap_target)) / (cap_dlfw_s + cap_dlbw_s)",
    "cap_wf_3": "bicep / 2 + cap_split_1",
    "cap_wb_3": "bicep / 2 - cap_split_1",
    "cap_af_3": "atan2(cap_h_2, cap_wf_3)",
    "cap_tf_3": "min(cap_af_3 + min(cap_af_3, cap_inflection_tilt), 90)",
    "cap_sf_3": "cap_h_2 / tan(cap_tf_3 / 2) - cap_wf_3",
    "cap_rf_3": "(cap_wf_3 * sin(cap_tf_3) - cap_h_2 * cos(cap_tf_3)) / (1 - cos(cap_tf_3))",
    "cap_lf_3": "cap_rf_3 * rad(cap_tf_3) + cap_sf_3",
    "cap_dlfh_3": "1 / tan(cap_tf_3 / 2) - rad(cap_tf_3) * cos(cap_tf_3) / (1 - cos(cap_tf_3)) + (cap_sf_3 * rad(cap_tf_3) + cap_wf_3 * sin(cap_tf_3) - cap_h_2 * (1 + cos(cap_tf_3))) / (1 - cos(cap_tf_3)) * cap_wf_3 / (cap_wf_3 * cap_wf_3 + cap_h_2 * cap_h_2) * (90 - cap_tf_3) / max(90 - cap_tf_3, 0.000001)",
    "cap_ab_3": "atan2(cap_h_2, cap_wb_3)",
    "cap_tb_3": "min(cap_ab_3 + min(cap_ab_3, cap_inflection_tilt), 90)",
    "cap_sb_3": "cap_h_2 / tan(cap_tb_3 / 2) - cap_wb_3",
    "cap_rb_3": "(cap_wb_3 * sin(cap_tb_3) - cap_h_2 * cos(cap_tb_3)) / (1 - cos(cap_tb_3))",
    "cap_lb_3": "cap_rb_3 * rad(cap_tb_3) + cap_sb_3",
    "cap_dlbh_3": "1 / tan(cap_tb_3 / 2) - rad(cap_tb_3) * cos(cap_tb_3) / (1 - cos(cap_tb_3)) + (cap_sb_3 * rad(cap_tb_3) + cap_wb_3 * sin(cap_tb_3) - cap_h_2 * (1 + cos(cap_tb_3))) / (1 - cos(cap_tb_3)) * cap_wb_3 / (cap_wb_3 * cap_wb_3 + cap_h_2 * cap_h_2) * (90 - cap_tb_3) / max(90 - cap_tb_3, 0.000001)",
    "cap_h_3": "cap_h_2 - (cap_lf_3 + cap_lb_3 - front_cap_target - back_cap_target) / (cap_dlfh_3 + cap_dlbh_3)",
    "cap_wf_4": "bicep / 2 + cap_split_1",
    "cap_wb_4": "bicep / 2 - cap_split_1",
    "cap_af_4": "atan2(cap_h_3, cap_wf_4)",
    "cap_tf_4": "min(cap_af_4 + min(cap_af_4, cap_inflection_tilt), 90)",
    "cap_sf_4": "cap_h_3 / tan(cap_tf_4 / 2) - cap_wf_4",
    "cap_rf_4": "(cap_wf_4 * sin(cap_tf_4) - cap_h_3 * cos(cap_tf_4)) / (1 - cos(cap_tf_4))",
    "cap_lf_4": "cap_rf_4 * rad(cap_tf_4) + cap_sf_4",
    "cap_dlfh_4": "1 / tan(cap_tf_4 / 2) - rad(cap_tf_4) * cos(cap_tf_4) / (1 - cos(cap_tf_4)) + (cap_sf_4 * rad(cap_tf_4) + cap_wf_4 * sin(cap_tf_4) - cap_h_3 * (1 + cos(cap_tf_4))) / (1 - cos(cap_tf_4)) * cap_wf_4 / (cap_wf_4 * cap_wf_4 + cap_h_3 * cap_h_3) * (90 - cap_tf_4) / max(90 - cap_tf_4, 0.000001)",
    "cap_ab_4": "atan2(cap_h_3, cap_wb_4)",
    "cap_tb_4": "min(cap_ab_4 + min(cap_ab_4, cap_inflection_tilt), 90)",
    "cap_sb_4": "cap_h_3 / tan(cap_tb_4 / 2) - cap_wb_4",
    "cap_rb_4": "(cap_wb_4 * sin(cap_tb_4) - cap_h_3 * cos(cap_tb_4)) / (1 - cos(cap_tb_4))",
    "cap_lb_4": "cap_rb_4 * rad(cap_tb_4) + cap_sb_4",
    "cap_dlbh_4": "1 / tan(cap_tb_4 / 2) - rad(cap_tb_4) * cos(cap_tb_4) / (1 - cos(cap_tb_4)) + (cap_sb_4 * rad(cap_tb_4) + cap_wb_4 * sin(cap_tb_4) - cap_h_3 * (1 + cos(cap_tb_4))) / (1 - cos(cap_tb_4)) * cap_wb_4 / (cap_wb_4 * cap_wb_4 + cap_h_3 * cap_h_3) * (90 - cap_tb_4) / max(90 - cap_tb_4, 0.000001)",
    "cap_h_4": "cap_h_3 - (cap_lf_4 + cap_lb_4 - front_cap_target - back_cap_target) / (cap_dlfh_4 + cap_dlbh_4)",
    "cap_height": "cap_h_4",
    "cap_split": "cap_split_1",
    "back_cap_width": "bicep / 2 - cap_split",
    "front_cap_width": "bicep / 2 + cap_split",
    "cap_constants_guard": "sqrt(cap_convex_share) * sqrt(1 - cap_convex_share) * sqrt(cap_inflection_tilt)",
    "cap_constants_ok": "cap_constants_guard / cap_constants_guard",
    "back_cap_solved": "back_cap_radius * rad(back_cap_turn) + cap_height / tan(back_cap_turn / 2) - back_cap_width",
    "front_cap_solved": "front_cap_radius * rad(front_cap_turn) + cap_height / tan(front_cap_turn / 2) - front_cap_width",
    "cap_fit_guard": "sqrt(0.1 - max(abs(back_cap_solved - back_cap_target), abs(front_cap_solved - front_cap_target))) * sqrt(back_cap_width) * sqrt(front_cap_width) * sqrt(cap_height)",
    "cap_fit_ok": "cap_fit_guard / cap_fit_guard",
    "back_chord_angle": "atan2(cap_height, back_cap_width)",
    "back_cap_turn": "min(back_chord_angle + min(back_chord_angle, cap_inflection_tilt), 90)",
    "back_cap_radius": "(back_cap_width * sin(back_cap_turn) - cap_height * cos(back_cap_turn)) / (1 - cos(back_cap_turn))",
    "back_cap_straight": "max(0, cap_height / tan(back_cap_turn / 2) - back_cap_width)",
    "back_upper_radius": "cap_constants_ok * cap_fit_ok * cap_convex_share * back_cap_radius",
    "back_lower_radius": "cap_constants_ok * cap_fit_ok * (1 - cap_convex_share) * back_cap_radius",
    "back_upper_handle": "4 / 3 * tan(back_cap_turn / 4) * back_upper_radius",
    "back_lower_handle": "4 / 3 * tan(back_cap_turn / 4) * back_lower_radius",
    "front_chord_angle": "atan2(cap_height, front_cap_width)",
    "front_cap_turn": "min(front_chord_angle + min(front_chord_angle, cap_inflection_tilt), 90)",
    "front_cap_radius": "(front_cap_width * sin(front_cap_turn) - cap_height * cos(front_cap_turn)) / (1 - cos(front_cap_turn))",
    "front_cap_straight": "max(0, cap_height / tan(front_cap_turn / 2) - front_cap_width)",
    "front_upper_radius": "cap_constants_ok * cap_fit_ok * cap_convex_share * front_cap_radius",
    "front_lower_radius": "cap_constants_ok * cap_fit_ok * (1 - cap_convex_share) * front_cap_radius",
    "front_upper_handle": "4 / 3 * tan(front_cap_turn / 4) * front_upper_radius",
    "front_lower_handle": "4 / 3 * tan(front_cap_turn / 4) * front_lower_radius",
    "back_cap_length": "length(s_cap_back_lower) + length(s_cap_back_mid) + length(s_cap_back_upper)",
    "front_cap_length": "length(s_cap_front_upper) + length(s_cap_front_mid) + length(s_cap_front_lower)",
    "cap_length": "back_cap_length + front_cap_length"
  },
  "points": [
    { "name": "s_crown", "op": "start", "x": "0", "y": "0" },
    { "name": "s_front_j1", "op": "offset", "from": "s_crown", "dx": "front_upper_radius * sin(front_cap_turn)", "dy": "front_upper_radius * (1 - cos(front_cap_turn))" },
    { "name": "s_front_j2", "op": "along_angle", "from": "s_front_j1", "angle": "front_cap_turn", "distance": "front_cap_straight" },
    { "name": "s_underarm_front", "op": "offset", "from": "s_crown", "dx": "front_cap_width", "dy": "cap_height" },
    { "name": "s_fc1", "op": "offset", "from": "s_crown", "dx": "front_upper_handle", "dy": "0" },
    { "name": "s_fc2", "op": "along_angle", "from": "s_front_j1", "angle": "front_cap_turn + 180", "distance": "front_upper_handle" },
    { "name": "s_fc3", "op": "along_angle", "from": "s_front_j2", "angle": "front_cap_turn", "distance": "front_lower_handle" },
    { "name": "s_fc4", "op": "offset", "from": "s_underarm_front", "dx": "-front_lower_handle", "dy": "0" },
    { "name": "s_back_j1", "op": "offset", "from": "s_crown", "dx": "-back_upper_radius * sin(back_cap_turn)", "dy": "back_upper_radius * (1 - cos(back_cap_turn))" },
    { "name": "s_back_j2", "op": "along_angle", "from": "s_back_j1", "angle": "180 - back_cap_turn", "distance": "back_cap_straight" },
    { "name": "s_underarm_back", "op": "offset", "from": "s_crown", "dx": "-back_cap_width", "dy": "cap_height" },
    { "name": "s_bc1", "op": "offset", "from": "s_underarm_back", "dx": "back_lower_handle", "dy": "0" },
    { "name": "s_bc2", "op": "along_angle", "from": "s_back_j2", "angle": "180 - back_cap_turn", "distance": "back_lower_handle" },
    { "name": "s_bc3", "op": "along_angle", "from": "s_back_j1", "angle": "360 - back_cap_turn", "distance": "back_upper_handle" },
    { "name": "s_bc4", "op": "offset", "from": "s_crown", "dx": "-back_upper_handle", "dy": "0" },
    { "name": "s_hem_back", "op": "offset", "from": "s_crown", "dx": "cap_split - hem_width / 2", "dy": "sleeve_length" },
    { "name": "s_hem_front", "op": "offset", "from": "s_crown", "dx": "cap_split + hem_width / 2", "dy": "sleeve_length" },
    { "name": "s_grain_top", "op": "offset", "from": "s_crown", "dx": "0", "dy": "cap_height / 2" },
    { "name": "s_grain_bottom", "op": "offset", "from": "s_crown", "dx": "0", "dy": "sleeve_length - 50" }
  ],
  "curves": [
    { "name": "s_cap_back_lower", "type": "cubic", "from": "s_underarm_back", "c1": "s_bc1", "c2": "s_bc2", "to": "s_back_j2" },
    { "name": "s_cap_back_mid", "type": "line", "from": "s_back_j2", "to": "s_back_j1" },
    { "name": "s_cap_back_upper", "type": "cubic", "from": "s_back_j1", "c1": "s_bc3", "c2": "s_bc4", "to": "s_crown" },
    { "name": "s_cap_front_upper", "type": "cubic", "from": "s_crown", "c1": "s_fc1", "c2": "s_fc2", "to": "s_front_j1" },
    { "name": "s_cap_front_mid", "type": "line", "from": "s_front_j1", "to": "s_front_j2" },
    { "name": "s_cap_front_lower", "type": "cubic", "from": "s_front_j2", "c1": "s_fc3", "c2": "s_fc4", "to": "s_underarm_front" },
    { "name": "s_seam_front", "type": "line", "from": "s_underarm_front", "to": "s_hem_front" },
    { "name": "s_hem", "type": "line", "from": "s_hem_front", "to": "s_hem_back" },
    { "name": "s_seam_back", "type": "line", "from": "s_hem_back", "to": "s_underarm_back" }
  ],
  "pieces": [
    {
      "name": "sleeve",
      "outline": [
        { "curve": "s_cap_back_lower" },
        { "curve": "s_cap_back_mid" },
        { "curve": "s_cap_back_upper" },
        { "curve": "s_cap_front_upper" },
        { "curve": "s_cap_front_mid" },
        { "curve": "s_cap_front_lower" },
        { "curve": "s_seam_front" },
        { "curve": "s_hem" },
        { "curve": "s_seam_back" }
      ],
      "grainline": { "from": "s_grain_top", "to": "s_grain_bottom" },
      "notches": [
        { "curve": "s_cap_back_lower", "distance": "back_armhole_to_notch", "marks": 2 },
        { "curve": "s_cap_front_upper", "distance": "0" },
        { "curve": "s_cap_front_upper", "distance": "front_cap_length - front_armhole_to_notch" }
      ]
    }
  ]
}
