{
  "version": 1,
  "name": "Rectangle with a dart",
  "source": "Toile engine example (ticket 0003)",
  "measurements": ["waist", "hip", "waist_to_hip"],
  "parameters": { "ease_hip": 10, "dart_length": 90 },
  "formulas": {
    "width": "hip / 4 + ease_hip",
    "dart_intake": "(hip - waist) / 4",
    "waist_seam": "length(waist_left) + length(waist_right)",
    "side_length": "length(side)",
    "dart_leg": "distance(L, P)"
  },
  "points": [
    { "name": "A", "op": "start", "x": "0", "y": "0" },
    { "name": "B", "op": "along_angle", "from": "A", "angle": "0", "distance": "width" },
    { "name": "C", "op": "perpendicular", "from": "A", "to": "B", "distance": "waist_to_hip" },
    { "name": "D", "op": "offset", "from": "C", "dx": "distance(A, B)", "dy": "0" },
    { "name": "M", "op": "midpoint", "from": "A", "to": "B" },
    { "name": "L", "op": "along_line", "from": "M", "to": "A", "distance": "dart_intake / 2" },
    { "name": "R", "op": "along_line", "from": "M", "to": "B", "distance": "dart_intake / 2" },
    { "name": "P", "op": "perpendicular", "from": "M", "to": "B", "distance": "dart_length" },
    { "name": "K1", "op": "along_line", "from": "B", "to": "D", "distance": "distance(B, D) / 3" },
    { "name": "K2", "op": "along_line", "from": "B", "to": "D", "distance": "2 * distance(B, D) / 3" },
    { "name": "G1", "op": "along_angle", "from": "P", "angle": "90", "distance": "20" },
    { "name": "G2", "op": "along_angle", "from": "G1", "angle": "90", "distance": "waist_to_hip - dart_length - 40" }
  ],
  "curves": [
    { "name": "waist_left", "type": "line", "from": "A", "to": "L" },
    { "name": "dart_left", "type": "line", "from": "L", "to": "P" },
    { "name": "dart_right", "type": "line", "from": "P", "to": "R" },
    { "name": "waist_right", "type": "line", "from": "R", "to": "B" },
    { "name": "side", "type": "cubic", "from": "B", "c1": "K1", "c2": "K2", "to": "D" },
    { "name": "hem", "type": "line", "from": "D", "to": "C" },
    { "name": "center", "type": "line", "from": "C", "to": "A" }
  ],
  "pieces": [
    {
      "name": "front",
      "outline": ["waist_left", "dart_left", "dart_right", "waist_right", "side", "hem", "center"],
      "grainline": { "from": "G1", "to": "G2" }
    }
  ]
}
