<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="landing" class="space-y-8">
    <div class="space-y-4">
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        {gettext("Sewing patterns made to your own measurements")}
      </h1>
      <p class="text-lg leading-8 text-base-content/80">
        {gettext(
          "Toile is a web app for drafting and developing sewing patterns. You start from basic blocks (bodice, skirt, sleeve) calculated from your own measurements, adapt them and print them at 1:1 scale."
        )}
      </p>
    </div>

    <ul class="grid gap-4 sm:grid-cols-3">
      <li class="rounded-box border border-base-300 bg-base-200 p-4">
        <.icon name="hero-arrows-pointing-out" class="size-6 text-primary" />
        <h2 class="mt-2 font-semibold">{gettext("Made to your measurements")}</h2>
        <p class="mt-1 text-sm text-base-content/70">
          {gettext(
            "The blocks are calculated from your measurements and follow along when you switch measurement profile."
          )}
        </p>
      </li>
      <li class="rounded-box border border-base-300 bg-base-200 p-4">
        <.icon name="hero-pencil-square" class="size-6 text-primary" />
        <h2 class="mt-2 font-semibold">{gettext("Adaptable")}</h2>
        <p class="mt-1 text-sm text-base-content/70">
          {gettext("Move points, change formulas and add seam allowance.")}
        </p>
      </li>
      <li class="rounded-box border border-base-300 bg-base-200 p-4">
        <.icon name="hero-printer" class="size-6 text-primary" />
        <h2 class="mt-2 font-semibold">{gettext("Printing at 1:1")}</h2>
        <p class="mt-1 text-sm text-base-content/70">
          {gettext("Print on A4 with page numbers and a test square.")}
        </p>
      </li>
    </ul>

    <p class="leading-7 text-base-content/80">
      {gettext("Toile is for both home sewists and small-scale pattern makers.")}
    </p>

    <div class="flex flex-wrap gap-3">
      <.link id="landing-register" navigate={~p"/users/register"} class="btn btn-primary">
        {gettext("Create account")} <span aria-hidden="true">&rarr;</span>
      </.link>
      <.link id="landing-log-in" navigate={~p"/users/log-in"} class="btn btn-ghost">
        {gettext("Log in")}
      </.link>
    </div>
  </section>
</Layouts.app>
