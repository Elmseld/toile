#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Across the back between the armhole creases, halfway between the neck bone and the underarm."
msgstr "Tvärs över ryggen mellan armhålsvecken, halvvägs mellan nackkotan och armhålan."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Across the front between the armhole creases, above the bust."
msgstr "Tvärs över bröstet mellan armhålsvecken, ovanför bysten."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Along one shoulder, from the side of the neck to the shoulder point."
msgstr "Längs ena axeln, från halsens sida till axelspetsen."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Arm length"
msgstr "Ärmlängd"

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Around the base of the neck, over the prominent bone at the back of the neck."
msgstr "Runt halsroten, över den utstående kotan i nacken."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Around the fullest part of the bust, with the tape level across the back."
msgstr "Runt bystens fylligaste del, med måttbandet vågrätt över ryggen."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Around the fullest part of the hips and seat, with the tape level."
msgstr "Runt stussens bredaste del, där rumpan är som bredast, med måttbandet vågrätt."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Around the fullest part of the upper arm, with the arm relaxed."
msgstr "Runt överarmens tjockaste del, med armen avslappnad."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Around the natural waist, the narrowest part of the torso. Tie a band there to mark it for the other measurements."
msgstr "Runt den naturliga midjan, bålens smalaste del. Knyt ett band där som markering för de andra måtten."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "Around the wrist, over the wrist bone."
msgstr "Runt handleden, över handledsknölen."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "At the side, from the waist down to the desired hem."
msgstr "Vid sidan, från midjan ned till önskad fållkant."

#: lib/toile_web/measurement_texts.ex
#, elixir-autogen, elixir-format
msgid "At the side, from the waist down to the fullest part of the hips."
msgstr "Vid sidan, från midjebandet rakt ned till stussens bredaste del."

